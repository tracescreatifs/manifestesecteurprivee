# Adresse du projet Supabase (Project URL), utilisée par le navigateur et le serveur
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique Supabase (sb_publishable_...), soumise aux règles RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé secrète Supabase (sb_secret_...), serveur uniquement, ne jamais l'exposer au navigateur
SUPABASE_SECRET_KEY=

# Adresse publique de la plateforme, pour construire les liens personnels, le lien ouvert et les QR codes
NEXT_PUBLIC_SITE_URL=

# Secret qui protège la tâche planifiée Vercel de maintien en éveil de Supabase
CRON_SECRET=
